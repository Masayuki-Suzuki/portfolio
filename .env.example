# Runtime configuration (Nuxt runtimeConfig)
# NUXT_ プレフィックス付き環境変数は起動時に nuxt.config.ts の runtimeConfig を上書きする。
# 非 public のキーはサーバ専用で、クライアントバンドルには含まれない。

# --- server only ---
# reCAPTCHA(GCP スコアベースキーの「レガシー秘密鍵」)
NUXT_RECAPTCHA_SECRET_KEY=
# bot 判定のスコア閾値(0.0-1.0、未設定時 0.5)
NUXT_RECAPTCHA_SCORE_THRESHOLD=0.5
NUXT_RESEND_API_KEY=
NUXT_MAIL_TO=
NUXT_MAIL_FROM=
NUXT_STRAPI_API_TOKEN=

# --- public (クライアントに公開される) ---
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
NUXT_PUBLIC_SCROLL_THRESHOLD=500
# GA4 測定 ID(G-XXXXXXXXXX)。本番ビルドのみ計測が有効
NUXT_PUBLIC_GTAG_ID=

# Strapi (blog CMS) origin — GraphQL endpoint とサムネイル解決に使用(ビルド時参照)
NUXT_PUBLIC_STRAPI_URL=https://dashboard.anonymous-frontend.dev
